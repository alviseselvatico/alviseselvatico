# Copy to .env locally. Never commit .env.

# --- LLM (D012). Aliases resolved at runtime; no model ID lives in code.
# Suggested values at bible date (verify current IDs): strong=claude-opus-5, cheap=claude-haiku-4-5
VME_LLM_PROVIDER=anthropic
VME_LLM_MODEL_CHEAP=
VME_LLM_MODEL_STRONG=
ANTHROPIC_API_KEY=
VME_LLM_MAX_TOKENS=8192
VME_LLM_MAX_ATTEMPTS=2
# Empty = provider default; otherwise low|medium|high|xhigh|max
VME_LLM_EFFORT=

# --- Ranking (Viral Score v0). Weights file: src/vme/ranking/weight_files/viral_v0.json by default.
VME_RANKING_FINALISTS=5
VME_RANKING_WEIGHTS_PATH=
VME_VERTICAL=general
VME_AUDIENCE=general English-speaking short-form viewers

# --- Editorial / human review
VME_TARGET_CLIP_MS=45000
# Operator identity written into every ReviewEvent (or pass --reviewer)
VME_REVIEWER=

# --- Transcription (D011). Local faster-whisper needs no key.
VME_STT_PROVIDER=faster_whisper
VME_STT_MODEL_SIZE=small
VME_STT_DEVICE=cpu
VME_STT_COMPUTE_TYPE=int8
# Empty = auto-detect; set e.g. en to force the language.
VME_STT_LANGUAGE=
VME_STT_BEAM_SIZE=5
# Later: hosted STT provider
TRANSCRIPTION_API_KEY=

# --- Storage / paths
VME_DB_PATH=./artifacts/vme.sqlite3
VME_ARTIFACTS_DIR=./artifacts

# --- Rendering (D013)
VME_RENDER_WIDTH=1080
VME_RENDER_HEIGHT=1920

# --- Later: YouTube OAuth/client configuration (Phase 3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Later: database (Phase 2+)
DATABASE_URL=
